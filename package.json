{
  "name": "cadence",
  "version": "0.2.1",
  "description": "Personal recurring items tracker with smart alerts.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cadence-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cadence-db --remote",
    "db:seed:local": "wrangler d1 execute cadence-db --local --file=./seed.sql",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "hono": "^4.13.11"
  }
}
